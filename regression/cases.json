[
  {
    "id": "REG-004-int64-poison",
    "category": "REGRESSION",
    "priority": "P0",
    "source": "缺陷:int64 溢出残留事务毒化共享连接回归锚",
    "action": {
      "kind": "sequence",
      "steps": [
        {
          "path": "/red-packets",
          "body": {
            "name": "开工红包",
            "amount_cents": 100,
            "quantity": 10,
            "influencer_id": 1,
            "created_by": 1,
            "unlimited": false,
            "scheduled_at": 1000000000000000000000000000000
          },
          "expect_status": 400
        },
        {
          "path": "/red-packets",
          "body": {
            "name": "开工红包",
            "amount_cents": 100,
            "quantity": 10,
            "influencer_id": 1,
            "created_by": 1,
            "unlimited": false
          },
          "expect_status": 201,
          "save": {
            "pid": "id"
          }
        }
      ]
    },
    "expected": {
      "db_rows": [
        {
          "table": "red_packet",
          "key": {
            "id": "{{pid}}"
          },
          "subset": {
            "status": 0,
            "quantity": 10,
            "scheduled_at": null
          }
        }
      ]
    },
    "regression_reason": "越界时间戳炸掉 INSERT 后事务未回滚 → 此后所有创建请求全崩的缺陷永久回归",
    "added": "2026-08-30T10:46:17.282777+00:00"
  },
  {
    "id": "REG-001-oversell",
    "category": "REGRESSION",
    "priority": "P0",
    "source": "缺陷:超发修复回归锚",
    "setup": [
      "DELETE FROM grant_log WHERE packet_id=9501",
      "DELETE FROM red_packet WHERE id=9501",
      "INSERT INTO red_packet(id,name,amount_cents,quantity,influencer_id,unlimited,expiry_ts,scheduled_at,status,remaining,created_by,created_at,updated_at,deleted) VALUES(9501,'ANCHOR-9501',100,5,1,0,NULL,NULL,1,5,1,0,0,0)"
    ],
    "action": {
      "kind": "concurrent",
      "count": 12,
      "path": "/red-packets/9501/grant"
    },
    "expected": {
      "success_count": 5,
      "db_count": [
        {
          "sql": "SELECT COUNT(*) FROM grant_log WHERE packet_id=9501",
          "expect": 5
        },
        {
          "sql": "SELECT remaining FROM red_packet WHERE id=9501",
          "expect": 0
        }
      ]
    },
    "regression_reason": "grant 卖光仍写 grant_log 的缺陷永久回归",
    "added": "2026-09-10T14:17:13.055630+00:00"
  },
