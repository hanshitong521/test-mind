{
  "openapi": "3.0.0",
  "info": {"title": "peak-sim-generic", "version": "1.0"},
  "paths": {
    "/stock": {
      "post": {
        "operationId": "createStock",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["sku", "warehouse_id", "qty"],
                "properties": {
                  "sku": {"type": "string", "minLength": 1},
                  "warehouse_id": {"type": "integer", "minimum": 1},
                  "qty": {"type": "integer", "minimum": 1, "maximum": 100}
                }
              }
            }
          }
        },
        "responses": {"201": {"description": "ok"}, "404": {"description": "warehouse missing"}}
      }
    },
    "/items": {
      "get": {
        "operationId": "listItems",
        "parameters": [
          {"name": "page", "in": "query", "required": true, "schema": {"type": "integer", "minimum": 1}},
          {"name": "size", "in": "query", "required": true, "schema": {"type": "integer", "minimum": 1, "maximum": 50}}
        ],
        "responses": {"200": {"description": "ok"}}
      }
    },
    "/coupons": {
      "post": {
        "operationId": "createCoupon",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["code", "request_id"],
                "properties": {
                  "code": {"type": "string", "minLength": 3},
                  "request_id": {"type": "string"}
                }
              }
            }
          }
        },
        "responses": {"201": {"description": "created"}, "200": {"description": "replay"}}
      }
    }
  }
}
