{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "requirement-mind/state",
  "title": "RequirementMind .requirementmind/ 状态文件数据模型",
  "notes": "每个顶层 key 对应一个落盘文件。所有 id 前缀固定；status/priority 等枚举是硬约束，脚本 scripts/state.mjs validate 据此校验。",
  "session": {
    "type": "object",
    "file": "session.json",
    "required": ["requirement", "phase", "updated_at"],
    "properties": {
      "requirement": { "type": "string", "description": "用户需求原文" },
      "phase": { "enum": ["SCANNED", "PARSED", "GRILLING", "SPEC_COMPILED", "REVIEWED", "VALIDATED", "GATED", "READY"] },
      "updated_at": { "type": "string" }
    }
  },
  "fact": {
    "type": "object",
    "file": "facts.json",
    "id_prefix": "FACT-",
    "required": ["id", "category", "statement", "source", "confidence", "status"],
    "properties": {
      "id": { "type": "string" },
      "category": { "enum": ["stack", "structure", "database", "api", "test", "business_rule", "history", "constraint", "doc"] },
      "statement": { "type": "string" },
      "source": {
        "type": "object",
        "required": ["type", "path"],
        "properties": {
          "type": { "enum": ["code", "sql", "doc", "test", "git", "config"] },
          "path": { "type": "string" },
          "line": { "type": "integer" }
        }
      },
      "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
      "status": { "enum": ["VERIFIED"] }
    }
  },
  "question": {
    "type": "object",
    "file": "questions.json",
    "id_prefix": "Q-",
    "required": ["id", "topic", "question", "reason", "priority", "options", "recommended_option", "recommendation_reason", "authority", "value", "status"],
    "properties": {
      "id": { "type": "string" },
      "topic": { "type": "string" },
      "question": { "type": "string" },
      "reason": { "type": "string" },
      "priority": { "enum": ["BLOCKING", "IMPORTANT", "OPTIONAL"] },
      "options": { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 5 },
      "recommended_option": { "enum": ["A", "B", "C", "D"] },
      "recommendation_reason": { "type": "string", "description": "一句话，须可追溯到 facts 或 path:line；证据不足时说明为何选「新规则」" },
      "authority": { "enum": ["USER_ONLY", "TECHNICAL"], "description": "Human-Only Gate：USER_ONLY 才能问用户；TECHNICAL 由 AI 采纳可辩护推荐自行裁决（freeze --auto），frontier 不展示" },
      "value": { "enum": ["HIGH", "MEDIUM", "LOW"], "description": "Question Value Score = 决策影响 × 不确定度 × 错误代价 ÷ 获取成本；LOW 不问，采纳推荐默认值进规格" },
      "status": { "enum": ["OPEN", "ANSWERED"] }
    }
  },
  "decision": {
    "type": "object",
    "file": "decisions.json",
    "id_prefix": "DEC-",
    "required": ["id", "question_id", "decision", "topic", "source", "status", "created_at"],
    "properties": {
      "id": { "type": "string" },
      "question_id": { "type": "string" },
      "decision": { "type": "string" },
      "topic": { "type": "string" },
      "source": { "enum": ["USER", "AI_DEFAULT"], "description": "USER=用户裁决；AI_DEFAULT=AI 依可辩护推荐自治裁决（authority=TECHNICAL 或 value=LOW，R11）" },
      "status": { "enum": ["FROZEN", "SUPERSEDED"] },
      "replaced_by": { "type": ["string", "null"] },
      "impact": { "type": "array", "items": { "type": "string" } },
      "basis": { "type": "array", "items": { "type": "string" }, "description": "AI_DEFAULT 必填建议：依据的 FACT/CON/ASM id" },
      "created_at": { "type": "string" }
    }
  },
  "assumption": {
    "type": "object",
    "file": "assumptions.json",
    "id_prefix": "ASM-",
    "required": ["id", "statement", "risk", "source", "status"],
    "properties": {
      "id": { "type": "string" },
      "statement": { "type": "string" },
      "risk": { "enum": ["HIGH", "MEDIUM", "LOW"] },
      "source": { "enum": ["MODEL_INFERENCE"] },
      "status": { "enum": ["UNVERIFIED", "CONFIRMED_AS_FACT", "RESOLVED"] }
    }
  },
  "conflict": {
    "type": "object",
    "file": "conflicts.json",
    "id_prefix": "CON-",
    "required": ["id", "left", "right", "severity", "status"],
    "properties": {
      "id": { "type": "string" },
      "left": { "type": "string", "description": "一侧陈述，带证据 file:line" },
      "right": { "type": "string", "description": "另一侧陈述，带证据 file:line" },
      "severity": { "enum": ["BLOCKING", "IMPORTANT"] },
      "status": { "enum": ["OPEN", "RESOLVED"] },
      "resolution_decision_id": { "type": ["string", "null"] }
    }
  },
  "challenge": {
    "type": "object",
    "file": "challenges.json",
    "id_prefix": "CH-",
    "required": ["id", "claim", "evidence", "validation", "severity", "status"],
    "properties": {
      "id": { "type": "string" },
      "claim": { "type": "string", "description": "CLAIM + 为什么可能不成立（Evidence Pack 紧凑格式，各一句）" },
      "challenge": { "type": "string", "description": "可选：旧版字段，合并进 claim" },
      "evidence": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
      "counterexample": { "type": "string", "description": "可选：什么场景会破坏该结论" },
      "impact": { "type": "string", "description": "若成立，破坏什么" },
      "confidence": { "type": "number", "minimum": 0, "maximum": 1, "description": "Reviewer 自评；<0.6 不得输出" },
      "validation": { "type": "string" },
      "severity": { "enum": ["BLOCKING", "HIGH", "MEDIUM"] },
      "status": { "enum": ["PENDING_VALIDATION", "CONFIRMED", "PLAUSIBLE", "REFUTED"] }
    }
  },
  "evidence": {
    "type": "object",
    "file": "evidence.json",
    "id_prefix": "EV-",
    "required": ["id", "challenge_id", "verdict", "reasoning"],
    "properties": {
      "id": { "type": "string" },
      "challenge_id": { "type": "string" },
      "verdict": { "enum": ["CONFIRMED", "PLAUSIBLE", "REFUTED"] },
      "reasoning": { "type": "string", "description": "裁决理由，含 file:line" },
      "suggested_severity": { "enum": ["BLOCKING", "HIGH", "MEDIUM", null] }
    }
  },
  "risk": {
    "type": "object",
    "file": "risk.json",
    "required": ["dimensions", "total", "tier", "updated_at"],
    "properties": {
      "dimensions": {
        "type": "object",
        "description": "八维各 0-3 分，score>=2 必须给 refs（stop 做可解析校验）；锚点见 references/risk-router.md",
        "required": ["business_criticality", "data_impact", "concurrency_risk", "security_risk", "compatibility_risk", "irreversibility", "blast_radius", "evidence_gap"],
        "additionalProperties": {
          "type": "object",
          "required": ["score"],
          "properties": {
            "score": { "type": "integer", "minimum": 0, "maximum": 3 },
            "refs": { "type": "array", "items": { "type": "string" }, "description": "FACT-/CON-/DEC- id" }
          }
        }
      },
      "total": { "type": "integer", "minimum": 0, "maximum": 24 },
      "tier": { "enum": ["LIGHT", "FOCUSED", "COUNCIL"] },
      "specialists": { "type": "array", "items": { "type": "string" } },
      "updated_at": { "type": "string" }
    }
  },
  "eval": {
    "type": "object",
    "file": "eval.json",
    "required": ["recorded_at"],
    "properties": {
      "recorded_at": { "type": "string" },
      "metrics": { "type": "object", "description": "state.mjs eval 的输出原样嵌入" },
      "missed_requirements": { "type": "integer", "description": "开发期 BLOCKER 揭示的遗漏需求数（Phase 8 后回填）" },
      "rework_count": { "type": "integer", "description": "因需求不清导致的返工次数" },
      "not_ask_me": { "type": "integer", "description": "用户说「这个不用问我」的次数" },
      "lessons": { "type": "string", "description": "下次会话的策略调整（对照 references/eval.md 阈值表）" }
    }
  },
  "gate": {
    "type": "object",
    "file": "gate.json",
    "required": ["status", "checklist", "hard_counters", "missing"],
    "properties": {
      "status": { "enum": ["READY_FOR_DEVELOPMENT", "BLOCKED"] },
      "checklist": {
        "type": "object",
        "required": ["business_goal", "scope", "core_flow", "business_rules", "data_model", "api_contract", "state_machine", "validation_rules", "permission", "concurrency", "idempotency", "exception_handling", "compatibility", "acceptance_criteria", "testability", "spec_consistency"],
        "additionalProperties": { "enum": ["PASS", "FAIL"] }
      },
      "hard_counters": {
        "type": "object",
        "required": ["blocking_questions", "blocking_conflicts", "critical_assumptions", "unvalidated_high_risks"],
        "additionalProperties": { "type": "integer", "minimum": 0 }
      },
      "missing": { "type": "array", "items": { "type": "string" } },
      "checked_at": { "type": "string" }
    }
  }
}
